{
  "name": "@fbkworks/screen",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/copy-css.mjs src dist && node ../../scripts/bundle-css.mjs src/styles/index.css dist/style.css"
  },
  "dependencies": {
    "@fbkworks/chart-core": "workspace:^",
    "@fbkworks/shared": "workspace:^",
    "@fbkworks/tokens": "workspace:^"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Full-screen data visualization components (tech-blue theme, scale-to-fit) for the FBK kit.",
  "keywords": [
    "vue",
    "vue3",
    "screen",
    "dashboard",
    "visualization",
    "echarts"
  ],
  "license": "MIT",
  "author": "54356",
  "homepage": "https://github.com/54356/frontend-business-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/54356/frontend-business-kit.git",
    "directory": "packages/screen"
  },
  "bugs": {
    "url": "https://github.com/54356/frontend-business-kit/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
