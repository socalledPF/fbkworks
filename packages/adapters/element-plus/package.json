{
  "name": "@fbk/adapter-element-plus",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./style.css": "./dist/style.css",
    "./dark.css": "./dist/dark.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node ../../../scripts/copy-css.mjs src dist"
  },
  "dependencies": {
    "@fbk/adapter-core": "workspace:^",
    "@fbk/shared": "workspace:^",
    "@fbk/tokens": "workspace:^"
  },
  "peerDependencies": {
    "element-plus": "^2.8.0",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Element Plus adapter for the FBK Vue 3 business component kit.",
  "keywords": [
    "vue",
    "vue3",
    "element-plus",
    "adapter"
  ],
  "license": "MIT",
  "author": "54356",
  "homepage": "https://github.com/54356/frontend-business-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/54356/frontend-business-kit.git",
    "directory": "packages/adapters/element-plus"
  },
  "bugs": {
    "url": "https://github.com/54356/frontend-business-kit/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  }
