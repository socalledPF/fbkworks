{
  "name": "@fbkworks/adapter-vant",
  "version": "0.6.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./style.css": "./dist/style.css",
    "./dark.css": "./dist/dark.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node ../../../scripts/copy-css.mjs src dist"
  },
  "dependencies": {
    "@fbkworks/adapter-core": "workspace:^",
    "@fbkworks/shared": "workspace:^",
    "@fbkworks/tokens": "workspace:^"
  },
  "peerDependencies": {
    "vant": "^4.9.0",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Vant 4 adapter for the FBK Vue 3 business component kit, with card-list data grid for mobile.",
  "keywords": [
    "vue",
    "vue3",
    "vant",
    "mobile",
    "adapter"
  ],
  "license": "MIT",
  "author": "socalledPF",
  "homepage": "https://github.com/socalledPF/fbkworks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socalledPF/fbkworks.git",
    "directory": "packages/adapters/vant"
  },
  "bugs": {
    "url": "https://github.com/socalledPF/fbkworks/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
