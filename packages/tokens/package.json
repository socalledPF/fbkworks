{
  "name": "@fbkworks/tokens",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./css": "./dist/css/tokens.css",
    "./dark.css": "./dist/css/dark.css",
    "./cyber.css": "./dist/css/cyber.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild && node ../../scripts/copy-css.mjs src/css dist/css"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Design tokens for the FBK Vue 3 business component kit: semantic tokens compiled to --fbk-* CSS variables.",
  "keywords": [
    "vue",
    "vue3",
    "design-tokens",
    "css-variables",
    "design-system"
  ],
  "license": "MIT",
  "author": "socalledPF",
  "homepage": "https://github.com/socalledPF/fbkworks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socalledPF/fbkworks.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/socalledPF/fbkworks/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
