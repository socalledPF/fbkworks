{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@fbkworks/tokens": [
        "packages/tokens/src/index.ts"
      ],
      "@fbkworks/tokens/css": [
        "packages/tokens/src/css/tokens.css"
      ],
      "@fbkworks/tokens/dark.css": [
        "packages/tokens/src/css/dark.css"
      ],
      "@fbkworks/shared": [
        "packages/shared/src/index.ts"
      ],
      "@fbkworks/adapter-core": [
        "packages/adapter-core/src/index.ts"
      ],
      "@fbkworks/adapter-element-plus": [
        "packages/adapters/element-plus/src/index.ts"
      ],
      "@fbkworks/adapter-vant": [
        "packages/adapters/vant/src/index.ts"
      ],
      "@fbkworks/adapter-naive-ui": [
        "packages/adapters/naive-ui/src/index.ts"
      ],
      "@fbkworks/components": [
        "packages/components/src/index.ts"
      ],
      "@fbkworks/components/*": [
        "packages/components/src/*"
      ],
      "@fbkworks/resolver": [
        "packages/resolver/src/index.ts"
      ],
      "@fbkworks/demos": [
        "packages/internal/demos/src/index.ts"
      ],
      "@fbkworks/test-utils": [
        "packages/internal/test-utils/src/index.ts"
      ],
      "@fbkworks/adapter-conformance": [
        "packages/internal/adapter-conformance/src/index.ts"
      ],
      "@fbkworks/build-config": [
        "packages/internal/build-config/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  }
}
