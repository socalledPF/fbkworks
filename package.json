{
  "name": "frontend-business-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "playground": "pnpm --filter @fbkworks/playground dev",
    "admin": "pnpm --filter @fbkworks/admin dev",
    "docs:dev": "pnpm --filter @fbkworks/docs dev",
    "docs:build": "turbo run docs:build",
    "check:packages": "pnpm -r --filter \"./packages/**\" exec publint",
    "check:types": "node scripts/check-package-types.mjs",
    "check:surface": "node scripts/check-type-surface.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "check:style-entries": "node scripts/check-style-entries.mjs",
    "check:impact": "node scripts/check-impact.mjs",
    "mock:backend": "node scripts/dev/mock-backend.mjs",
    "verify:data-contract": "node scripts/dev/run-contract-check.mjs",
    "check:runtime-deps": "node scripts/check-runtime-deps.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "publish:all": "node scripts/publish-all.mjs",
    "publish:dry": "node scripts/publish-all.mjs --dry-run",
    "check:publish-order": "node scripts/publish-all.mjs --check-only",
    "gen:resolver-map": "node scripts/gen-resolver-map.mjs",
    "check:resolver-map": "node scripts/gen-resolver-map.mjs --check",
    "gen:api-snapshot": "node scripts/gen-api-snapshot.mjs",
    "check:api-snapshot": "node scripts/gen-api-snapshot.mjs --check",
    "size": "node scripts/gen-size-baseline.mjs --print",
    "gen:size-baseline": "node scripts/gen-size-baseline.mjs",
    "check:size": "node scripts/gen-size-baseline.mjs --check",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "verify:fresh": "node scripts/verify-fresh-clone.mjs",
    "gen:style-index": "node scripts/gen-style-entries.mjs",
    "gen:chart-fixtures": "node scripts/gen-chart-fixtures.mjs",
    "check:style-index": "node scripts/gen-style-entries.mjs --check",
    "lint:deps": "depcruise packages apps --config dependency-cruiser.config.mjs",
    "gen:api": "pnpm --filter @fbkworks/docs gen:api",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm lint:deps && pnpm typecheck && pnpm test && pnpm build && pnpm check:surface && pnpm check:api-snapshot && pnpm check:size && pnpm check:styles && pnpm check:style-index && pnpm check:style-entries && pnpm check:runtime-deps && pnpm check:packages && pnpm check:types && pnpm check:consumer && pnpm check:resolver-map && pnpm check:capabilities && pnpm check:publish-order && pnpm check:diagrams && pnpm docs:build",
    "check:consumer": "pnpm --filter @fbkworks/consumer-smoke typecheck",
    "check:diagrams": "pnpm --filter @fbkworks/docs check:diagrams"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@fbkworks/build-config": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitejs/plugin-vue-jsx": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "dependency-cruiser": "^16.0.0",
    "echarts": "^6.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "publint": "^0.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "unbuild": "^3.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
